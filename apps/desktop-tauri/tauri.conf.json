{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rLogs",
  "version": "0.1.2",
  "identifier": "app.rlogs.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix desktop/ui run build",
    "frontendDist": "../desktop/ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../desktop/ui/dist": "apps/desktop/ui/dist",
      "../../assets": "assets",
      "../../plugins/builtin/desktop": "plugins/builtin/desktop",
      "../../plugins/games/blue-protocol-star-resonance/protocol-packs": "plugins/games/blue-protocol-star-resonance/protocol-packs",
      "../../tests/fixtures/replay": "tests/fixtures/replay"
    }
  }
}
