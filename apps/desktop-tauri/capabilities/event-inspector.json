{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "event-inspector-window",
  "description": "Read-only native window capabilities for the rLogs Event Inspector.",
  "windows": ["event-inspector"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize"
  ]
}
