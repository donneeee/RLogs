{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native window controls for the local rLogs desktop shell.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-quit-rlogs",
    "allow-open-release-notes",
    "allow-show-event-inspector",
    "allow-show-combat-overlay",
    "allow-assign-hotkey",
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
