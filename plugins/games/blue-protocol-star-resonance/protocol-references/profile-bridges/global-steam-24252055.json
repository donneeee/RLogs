{
  "schema_version": 1,
  "build": {
    "deployment_id": "global",
    "channel": "steam",
    "distribution_app_id": "3681810",
    "build_id": "24252055"
  },
  "purpose": "Join privacy-reviewed character runtime evidence to exact-build static definitions without treating catalog membership as character ownership.",
  "rules": [
    "Only current-build runtime evidence can establish ownership, equipped state, level, or progression for a character.",
    "Static CTB records can name and describe an ID after that ID is observed on an allowed character-facing route.",
    "Static definitions can never establish character ownership or equipped state.",
    "Historical schemas remain hypotheses until the current route, field shape, update semantics, and privacy policy are verified.",
    "Account, open, platform, login, credential, token, private-chat, mail, payment, and anti-cheat fields are never profile sources.",
    "An unmapped field remains absent from CharacterProfilePatch; it is never filled from a nearby integer or a static-table coincidence."
  ],
  "surfaces": [
    {
      "surface": "identity",
      "canonical_fields": [
        "character.character_id",
        "display_id",
        "display_name",
        "server_id"
      ],
      "runtime": {
        "route": "WorldNtf/SyncContainerData",
        "state": "partially_verified",
        "verified_fields": [
          "character.character_id",
          "display_id",
          "display_name"
        ],
        "implemented_but_not_present_in_verified_snapshot": [
          "server_id"
        ]
      },
      "static_definitions": [],
      "website_policy": "character key required; display fields opt-in"
    },
    {
      "surface": "class_and_specialization",
      "canonical_fields": [
        "class_id",
        "specialization_id",
        "combat_professions"
      ],
      "runtime": {
        "route": "WorldNtf/SyncContainerData",
        "state": "partially_verified",
        "verified_fields": [
          "class_id"
        ],
        "unmapped_fields": [
          "specialization_id",
          "combat_professions"
        ]
      },
      "static_definitions": [
        "ctb.ProfessionSystemTable",
        "ctb.ProfessionTable"
      ],
      "website_policy": "public after runtime correlation"
    },
    {
      "surface": "level_and_progression",
      "canonical_fields": [
        "level",
        "progression",
        "season",
        "season_strength"
      ],
      "runtime": {
        "route": "WorldNtf/SyncContainerData",
        "state": "partially_verified",
        "verified_fields": [
          "level"
        ],
        "unmapped_fields": [
          "progression",
          "season",
          "season_strength"
        ]
      },
      "static_definitions": [
        "ctb.PlayerLevelTable",
