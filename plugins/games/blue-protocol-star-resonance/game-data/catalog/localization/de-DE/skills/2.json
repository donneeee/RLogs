  },
  {
    "schema_version": 2,
    "locale": "de-DE",
    "key": "skill.1926.description",
    "text": "Verbraucht <style=\"accent-gn\">30</style> <style=\"accent-gn\">Wut</style>, um die Waffe zu schwingen und ein Vakuum zu erzeugen, das Gegner in der Nähe heranzieht. Verursacht <style=\"physical\">Angriff-SCH</style>, <linktext=3000><style=\"ItemQuality_5\">unterbricht</style></linktext> ihre Aktionen und verringert ihre Bewegung-GES für <style=\"accent-gn\">8 Sek.</style> um <style=\"accent-gn\">70 %</style>. <br><br><size=22><style=\"tipsYellow\">Tipps: Zieht Monster effektiv in Reichweite, um sie schneller zu erledigen.</style></size>",
    "availability": [
