  {
    "schema_version": 2,
    "locale": "id-ID",
    "key": "skill.1926.description",
    "text": "Mengonsumsi <style=\"accent-gn\">30</style> poin <style=\"accent-gn\">Fury</style>, mengayunkan senjata untuk menciptakan tekanan udara. Menarik musuh di sekitar ke arahmu, mengakibatkan <style=\"physical\">PDMG</style> dan <linktext=3000><style=\"ItemQuality_5\">Interrupt</style></linktext> mereka, serta mengurangi <style=\"accent-gn\">70%</style> Move Speed selama <style=\"accent-gn\">8</style> detik.<br><br><size=22><style=\"tipsYellow\"> Strategi: Efektif mengumpulkan banyak musuh agar bisa dihabisi lebih cepat.</style></size>",
    "availability": [
