  {
    "schema_version": 2,
    "locale": "id-ID",
    "key": "skill.1606.description",
    "text": "Setelah mengisi daya untuk sesaat, menginjak ke arah depan dan melancarkan tebasan dahsyat ke arah target untuk mengakibatkan <style=\"physical\">PDMG</style> dan memulihkan <style=\"accent-gn\">25</style> <style=\"accent-gn\">Flame Soul</style>. Jika serangan mengenai target, langsung memulihkan <style=\"physical\">5%</style> dari Max HP diri sendiri.<br><br><size=22><style=\"tipsYellow\">Strategi: Lancarkan di tengah DPS untuk meningkatkan kemampuan bertahan secara efektif. Lancarkan setelah Manic Firedance untuk menambahkan HP yang berkurang.</style></size>",
    "availability": [
