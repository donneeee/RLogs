      "confidence": "verified"
    }
  },
  {
    "schema_version": 2,
    "locale": "es-ES",
    "key": "skill.1907.description",
    "text": "<style=\"accent-gn\">Eco Agrietado</style><br>Desata el poder de la roca para infligir al instante <style=\"physical\">DÑO de ataque</style> en un área grande al frente y <linktext=3005><style=\"ItemQuality_5\">aturdir</style></linktext> a los enemigos durante 3 s. Luego, condensa energía para obtener de inmediato <style=\"accent-gn\">5</style> <style=\"accent-gn\">cristales de arena</style>. También pone al lanzador en el estado <style=\"accent-gn\">Furia Rocosa</style>.<br><style=\"accent-gn\">Furia Rocosa</style><br>Dura <style=\"accent-gn\">8 s</style>, otorga <linktext=1091><style=\"ItemQuality_5\">superarmadura</style></linktext>, aumenta la armadura un <style=\"accent-gn\">100 %</style> y los PS máx. un <style=\"accent-gn\">50 %</style>, y otorga <style=\"accent-gn\">40</style> de <style=\"accent-gn\">furia</style> con el tiempo.<br><br><size=22><style=\"tipsYellow\">Consejo: Úsala cuando te enfrentes a una cantidad extremadamente alta de DÑO recibido.</style></size>",
    "availability": [
      {
        "deployment_id": "global",
        "channel": "steam",
        "client_build": "24252055"
      }
    ],
    "provenance": {
      "source": "official-game-localization",
      "reference": "client-build:global/steam/24252055#localization-1505346522",
      "confidence": "verified"
    }
  },
  {
