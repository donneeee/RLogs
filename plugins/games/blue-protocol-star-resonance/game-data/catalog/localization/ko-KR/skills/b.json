  {
    "schema_version": 2,
    "locale": "ko-KR",
    "key": "skill.6524.description",
    "text": "코인을 한 번 던집니다. <style=\"physical\">50%</style> 확률로 <style=\"physical\">체력을 10pt 회복</style>합니다. <style=\"physical\">40%</style> 확률로 낙뢰를 끌어들여 <style=\"physical\">체력이 10pt 감소</style>합니다. <style=\"physical\">10%</style> 확률로 <style=\"physical\">체력을 전부 회복</style>합니다.<br><i><style=\"text_third_gray\">[어떤 대륙에서 온 신비한 아이템!]</style></i>",
    "availability": [
