      "confidence": "verified"
    }
  },
  {
    "schema_version": 2,
    "locale": "fr-FR",
    "key": "skill.1907.description",
    "text": "<style=\"accent-gn\">Écho fracturant</style><br>Libère le Pouvoir de la roche, infligeant instantanément des <style=\"physical\">dégâts d'attaque</style> dans une large zone devant soi et <linktext=3005><style=\"ItemQuality_5\">étourdissant</style></linktext> les ennemis pendant 3 s, puis condense de l'énergie pour obtenir immédiatement <style=\"accent-gn\">5</style> <style=\"accent-gn\">cristaux de sable</style>. Place également le conjurateur dans l'état <style=\"accent-gn\">Fureur de la roche</style>.<br><style=\"accent-gn\">Fureur de la roche</style><br>Dure <style=\"accent-gn\">8 s</style>, confère une <linktext=1091><style=\"ItemQuality_5\">super armure</style></linktext>, augmente l'armure de <style=\"accent-gn\">100 %</style> et les PV max de <style=\"accent-gn\">50 %</style>, et confère <style=\"accent-gn\">40</style> points de <style=\"accent-gn\">rage</style> sur la durée.<br><br><size=22><style=\"tipsYellow\">Astuce : à utiliser face à des dégâts entrants extrêmement élevés.</style></size>",
    "availability": [
      {
        "deployment_id": "global",
        "channel": "steam",
        "client_build": "24252055"
      }
    ],
    "provenance": {
      "source": "official-game-localization",
      "reference": "client-build:global/steam/24252055#localization-1505346522",
      "confidence": "verified"
    }
  },
