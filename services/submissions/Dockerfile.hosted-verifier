FROM rust:1.94-bookworm AS builder

WORKDIR /src
COPY . .
RUN cargo build --locked --release -p rlogs-submission-service

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 rlogs \
    && install --directory --owner rlogs --group rlogs /tmp/rlogs-hosted-verifier

COPY --from=builder /src/target/release/rlogs-submission-service /usr/local/bin/rlogs-submission-service

ENV RLOGS_HOSTED_VERIFIER=1 \
    RLOGS_SUBMISSION_LISTEN=0.0.0.0:8080 \
    RLOGS_HOSTED_ARTIFACT_ORIGIN=http://rlogs-artifacts.r2 \
    RLOGS_HOSTED_STAGING=/tmp/rlogs-hosted-verifier

EXPOSE 8080
USER rlogs
ENTRYPOINT ["/usr/local/bin/rlogs-submission-service"]
