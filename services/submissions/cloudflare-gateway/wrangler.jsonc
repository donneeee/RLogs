{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rlogs-submissions",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-31",
  "vars": {
    "ALLOWED_ORIGIN": "https://rlogs-app.github.io"
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "rlogs-backend"
    }
  ]
}
